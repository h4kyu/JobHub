{
  "type": "object",
  "properties": {
    "postings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": { "type": "integer" },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skill": { "type": "string" },
                "category": {
                  "type": "string",
                  "enum": ["language", "library/tool", "domain knowledge", "systems concept", "math/theory", "hardware", "process"]
                },
                "importance": { "type": "string", "enum": ["required", "preferred"] },
                "status": { "type": "string", "enum": ["have", "partial", "missing"] },
                "evidence": { "type": "string" }
              },
              "required": ["skill", "category", "importance", "status", "evidence"]
            }
          }
        },
        "required": ["job_id", "skills"]
      }
    }
  },
  "required": ["postings"]
}
